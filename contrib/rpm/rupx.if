
## <summary>policy for rupx</summary>


########################################
## <summary>
##	Transition to rupx.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
#
interface(`rupx_domtrans',`
	gen_require(`
		type rupx_t, rupx_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, rupx_exec_t, rupx_t)
')


########################################
## <summary>
##	Execute rupx server in the rupx domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`rupx_initrc_domtrans',`
	gen_require(`
		type rupx_initrc_exec_t;
	')

	init_labeled_script_domtrans($1, rupx_initrc_exec_t)
')


########################################
## <summary>
##	Search rupx lib directories.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`rupx_search_lib',`
	gen_require(`
		type rupx_var_lib_t;
	')

	allow $1 rupx_var_lib_t:dir search_dir_perms;
	files_search_var_lib($1)
')

########################################
## <summary>
##	Read rupx lib files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`rupx_read_lib_files',`
	gen_require(`
		type rupx_var_lib_t;
	')

	files_search_var_lib($1)
	read_files_pattern($1, rupx_var_lib_t, rupx_var_lib_t)
')

########################################
## <summary>
##	Manage rupx lib files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`rupx_manage_lib_files',`
	gen_require(`
		type rupx_var_lib_t;
	')

	files_search_var_lib($1)
	manage_files_pattern($1, rupx_var_lib_t, rupx_var_lib_t)
')

########################################
## <summary>
##	Manage rupx lib directories.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`rupx_manage_lib_dirs',`
	gen_require(`
		type rupx_var_lib_t;
	')

	files_search_var_lib($1)
	manage_dirs_pattern($1, rupx_var_lib_t, rupx_var_lib_t)
')


########################################
## <summary>
##	All of the rules required to administrate
##	a rupx environment
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access.
##	</summary>
## </param>
## <rolecap/>
#
interface(`rupx_admin',`
	gen_require(`
		type rupx_t;
		type rupx_initrc_exec_t;
		type rupx_var_lib_t;
	')

	allow $1 rupx_t:process { ptrace signal_perms };
	ps_process_pattern($1, rupx_t)

	rupx_initrc_domtrans($1)
	domain_system_change_exemption($1)
	role_transition $2 rupx_initrc_exec_t system_r;
	allow $2 system_r;

	files_search_var_lib($1)
	admin_pattern($1, rupx_var_lib_t)

')

